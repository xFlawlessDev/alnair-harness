/target
**/*.rs.bk
.DS_Store

# Release archives and SHA256SUMS produced by the release build / local
# installer (docs/RELEASE.md). Build outputs, never sources: `dist/` is
# recreated by `cargo build --profile release-dist`, and committing a binary
# here would put a 38 MB artifact in history that goes stale on the next bump.
/dist/

# Node tooling (web/ harness)
.wrangler/
node_modules/

# Runner-setup prompt; holds a runner registration token once filled in.
/prompt.txt

# Local test credentials
cred.md

# Upstream xai-org/grok-build reference clone
/grok-build/

# Local API keys (MiniMax TTS key for alnair-videos)
env.md
